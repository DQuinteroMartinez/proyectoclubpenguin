# ==========================================
# SPRING BOOT & ECLIPSE (Backend)
# ==========================================
# Archivos de propiedades con credenciales
**/src/main/resources/application.properties
**/src/main/resources/application.yml

# Archivos de compilación y temporales de Maven / Gradle
**/target/
**/build/
**/bin/

# Archivos de proyecto e IDE (Eclipse / WebStorm / STS)
**/.settings/
**/.project
**/.classpath
**/.factorypath
**/.idea/

# ==========================================
# ANGULAR CLI & NODE (Frontend)
# ==========================================
# Dependencias y construcciones
node_modules/
**/node_modules/
dist/
**/dist/
out-tsc/
**/out-tsc/
.angular/
**/.angular/
.ng/
**/tmp/
**/coverage/

# Variables de entorno y cachés
.env
*.tsbuildinfo

# Logs de error
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos del sistema operativo
.DS_Store
Thumbs.db